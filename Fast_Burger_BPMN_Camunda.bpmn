  <process id="Process_FastBurger_V5" name="Fast Burger - Venta de Hamburguesas" isExecutable="false">
    <laneSet id="LaneSet_V5">
      <lane id="Lane_Cocina_V5" name="Cocina">
        <flowNodeRef>Gateway_Ingredientes_V5</flowNodeRef>
        <flowNodeRef>VerificarIngredientes_V5</flowNodeRef>
        <flowNodeRef>PrepararPedido_V5</flowNodeRef>
      </lane>
      <lane id="Lane_Cajero_V5" name="Empleado / Cajero">
        <flowNodeRef>RegistrarPedido_V5</flowNodeRef>
        <flowNodeRef>TomarPedido_V5</flowNodeRef>
        <flowNodeRef>MostrarMenu_V5</flowNodeRef>
        <flowNodeRef>OfrecerAlternativa_V5</flowNodeRef>
        <flowNodeRef>CalcularTotal_V5</flowNodeRef>
        <flowNodeRef>CobrarPedido_V5</flowNodeRef>
      </lane>
      <lane id="Lane_Cliente_V5" name="Cliente">
        <flowNodeRef>Gateway_Confirma_V5</flowNodeRef>
        <flowNodeRef>Gateway_Pago_V5</flowNodeRef>
        <flowNodeRef>Start_V5</flowNodeRef>
        <flowNodeRef>SolicitarMenu_V5</flowNodeRef>
        <flowNodeRef>ConfirmarPedido_V5</flowNodeRef>
        <flowNodeRef>ModificarPedido_V5</flowNodeRef>
        <flowNodeRef>RealizarPago_V5</flowNodeRef>
        <flowNodeRef>EntregarPedido_V5</flowNodeRef>
        <flowNodeRef>OtroMetodo_V5</flowNodeRef>
        <flowNodeRef>RecibirPedido_V5</flowNodeRef>
        <flowNodeRef>End_V5</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_V5" name="Inicio">
      <outgoing>F01</outgoing>
    </startEvent>
    <exclusiveGateway id="Gateway_Confirma_V5" name="¿Cliente confirma?">
      <incoming>F06</incoming>
      <outgoing>F07</outgoing>
      <outgoing>F08</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Ingredientes_V5" name="¿Hay ingredientes?">
      <incoming>F10</incoming>
      <outgoing>F11</outgoing>
      <outgoing>F12</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Pago_V5" name="¿Pago aprobado?">
      <incoming>F17</incoming>
      <outgoing>F18</outgoing>
      <outgoing>F19</outgoing>
    </exclusiveGateway>
    <endEvent id="End_V5" name="Fin">
      <incoming>F22</incoming>
    </endEvent>
